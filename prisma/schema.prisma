generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite does not support native enums.
// Role values: "ADMIN" | "USER"
// Company values: "PEI" | "PM" | "PKS" — a user can belong to several; stored as a
// JSON array string in the `company` column (see companies @map below). null = none.
// ConversionStatus values: "SUCCESS" | "FAILED"
// Enforced by Zod at the API layer.

model User {
  id           String   @id @default(cuid())
  username     String
  email        String   @unique
  passwordHash String
  role         String   @default("USER")
  companies    String?  @map("company") // JSON array of PEI|PM|PKS; see lib/companies.js
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conversionLogs ConversionLog[]
  searchLogs     SearchLog[]
}

model Customer {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  // JSON: which spreadsheet columns map to which BOM fields (fixed per customer).
  // null → the standard layout (see DEFAULT_MAPPING in services/bomExtractor.js).
  columnMapping String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  uomMappings    UnitOfMeasureMapping[]
  conversionLogs ConversionLog[]
}

model UnitOfMeasureMapping {
  id               String   @id @default(cuid())
  customerId       String
  customerUOM      String
  peckoUOM         String
  conversionFactor Float    @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, customerUOM])
}

model ManufacturerMapping {
  id                   String   @id @default(cuid())
  customerManufacturer String   @unique
  peckoManufacturer    String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ProductRegistry {
  id         String @id @default(cuid())
  itemName   String @unique
  externalId String
}

model ConversionLog {
  id                String   @id @default(cuid())
  userId            String?
  customerId        String?
  originalFilename  String
  status            String
  productsConverted Int      @default(0)
  bomsConverted     Int      @default(0)
  createdAt         DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

// RFQ dashboard: a full snapshot of the "PENDING PROJECT" master sheet, replaced wholesale on each
// sync (the Excel file is the source of truth; diffing ~900 rows isn't worth it).
// status: COMPLETED | PENDING_REVIEW | OTHER | NONE  (derived from the row's fill color)
model RfqProject {
  id                 String    @id @default(cuid())
  rowNumber          Int
  projectId          String
  customer           String    @default("")
  linkSource         String    @default("")
  pic                String    @default("")
  projectType        String    @default("")
  notes              String    @default("")
  rfqDueDateRaw      String    @default("")
  rfqDueDate         DateTime?
  rfqReceivedDateRaw String    @default("")
  sofeaDateRaw       String    @default("")
  submissionDateRaw  String    @default("")
  status             String
  syncedAt           DateTime  @default(now())

  @@index([status])
}

model RfqSync {
  id            String   @id @default(cuid())
  syncedAt      DateTime @default(now())
  source        String   // 'upload' | 'webhook'
  total         Int      @default(0)
  completed     Int      @default(0)
  pendingReview Int      @default(0)
  other         Int      @default(0)
  none          Int      @default(0)
}

// Cached TrustedParts result per part number (one row per unique part). Served on
// repeat searches so we don't re-hit the API; refreshed on demand. See routes/partSourcing.js.
model SearchCache {
  id          String   @id @default(cuid())
  partNumber  String   @unique // normalized cache key (trimmed + uppercased)
  query       String            // the raw query as first searched
  result      String            // JSON of the normalized search response { query, parts }
  resultCount Int      @default(0) // total distributor offers shown, for metrics
  refreshedAt DateTime @default(now()) // last time this was fetched live
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One row per search event (for the Source Raw Materials analytics dashboard).
// username is denormalized so history survives user deletion.
model SearchLog {
  id          String   @id @default(cuid())
  userId      String?
  username    String
  partNumber  String
  resultCount Int      @default(0)
  cacheHit    Boolean  @default(false) // served from cache vs fetched live
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// Cached alternative/cross-reference suggestions per part (same policy as SearchCache:
// cache forever, refresh on demand). See services/alternativeParts.js.
model AlternativesCache {
  id          String   @id @default(cuid())
  partNumber  String   @unique // normalized key (trimmed + uppercased)
  result      String   // JSON: { alternatives: [...], checkedAt }
  refreshedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
